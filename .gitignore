# Allow only project scripts and documentation.
/*
!/.gitignore
!/.gitattributes
!/*.md
!/*.txt
!/scripts/
/scripts/**
!/scripts/**/
!/scripts/**/*.R
!/scripts/**/*.r
!/scripts/**/*.py
!/scripts/**/*.sh
!/scripts/**/*.ps1
!/scripts/**/*.md
!/scripts/**/*.txt
!/scripts/**/*.Rmd
!/scripts/**/*.qmd
# Temporary/editor files, including inside scripts.
**/__pycache__/
**/.ipynb_checkpoints/
**/.Rproj.user/
**/*~
**/*.tmp
**/*.log
**/.DS_Store
